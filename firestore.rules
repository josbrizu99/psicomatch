rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Los profesionales deben ser públicos para poder mostrarlos en la landing page
    match /professionals/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Reglas temporales más permisivas para el resto (debugging)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
